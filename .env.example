# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `pnpm supabase status`.

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key for CAPTCHA on sign-in (leave empty locally).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_, never import from client code) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (local Google sign-in; optional) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Local CLI only: this container/registry setup pulls Supabase images from Docker Hub ---
# SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io
