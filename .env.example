# Environment variables. On Vercel, set these in Project Settings → Environment Variables.
# For terminal use, copy to .env.local (git-ignored). Never commit real secrets.

# --- Public (shipped to the browser) ---
# https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key for CAPTCHA on sign-in (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only: never prefix with NEXT_PUBLIC_, never import from client code ---
# Secret key (sb_secret_…) or legacy service_role key. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database scripts (pnpm db:push / db:reset) and GitHub Actions ---
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
# db:reset only runs when SUPABASE_ENV=dev AND SUPABASE_PROJECT_ID equals SUPABASE_DEV_PROJECT_ID.
SUPABASE_ENV=
SUPABASE_DEV_PROJECT_ID=

# --- Optional local Docker stack / tests ---
# SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io
# PLAYWRIGHT_CHROMIUM_PATH=/path/to/chrome
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
